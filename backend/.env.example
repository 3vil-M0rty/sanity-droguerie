# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-secret-key-change-this

# Server
PORT=5000
NODE_ENV=development

# CORS — the deployed frontend's URL(s). Comma-separated if you
# need more than one (e.g. production + a Vercel preview
# deployment). Leave unset for local development (defaults to the
# Vite dev server on localhost:5173).
CORS_ORIGINS=https://your-app.vercel.app
# Single-URL alternative to CORS_ORIGINS above — kept for backward
# compatibility. If both are set, CORS_ORIGINS wins.
FRONTEND_URL=

# ------------------------------------------------------------
# USER-GENERATED CONTENT TRANSLATION (fr / en / ar)
# ------------------------------------------------------------
# Which content language a newly-detected/untagged piece of text
# falls back to. Must be one of fr, en, ar.
# Which content languages to translate into — should match the
# frontend's SUPPORTED_LANGUAGES (src/config/i18n.config.js) exactly.
# Comma-separated, no spaces needed. Leave unset to use the default
# below (the 6 languages the frontend ships with today).
CONTENT_LANGUAGES=en,fr,ar,es,pt,de

DEFAULT_CONTENT_LANGUAGE=fr

# Which translation API to use for auto-translating product names,
# job titles, descriptions, notes, etc. One of: google, libretranslate,
# deepl. Leave unset to run without auto-translation (translations
# can still be entered manually from the UI; nothing else breaks).
TRANSLATION_PROVIDER=

# --- google (Google Cloud Translation API v2) ---
GOOGLE_TRANSLATE_API_KEY=

# --- libretranslate (self-hosted or hosted instance) ---
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# --- deepl ---
DEEPL_API_KEY=
# Optional override; auto-picked from the key format (":fx" suffix = free tier) otherwise.
DEEPL_API_HOST=

# Per-call timeout / retry tuning (optional, sensible defaults apply)
TRANSLATION_TIMEOUT_MS=8000
TRANSLATION_MAX_RETRIES=2

# ------------------------------------------------------------
# FILE STORAGE — Cloudinary (photos, logos, documents) — services/storageService.js
# Used first when set. Cloudinary console → Dashboard → "API environment variable":
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# (or the three separate variables below). Photos are public images; documents
# (HR, purchasing, delivery proofs) are private and open with a link that expires.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Folder that holds every file of this platform (default: sanity)
# CLOUDINARY_FOLDER=sanity

# ------------------------------------------------------------
# FILE STORAGE — Cloudflare R2 (photos, logos, documents) — services/storageService.js
# Used when Cloudinary is not set. Leave both empty to keep files on this server's disk (backend/uploads):
# fine for development and a demo, NOT for production.
# Cloudflare dashboard → R2 → create 2 buckets:
#   sanity-public   Settings → Public access: enable r2.dev, or connect a
#                   custom domain (e.g. files.your-domain.ma) → R2_PUBLIC_URL
#   sanity-private  no public access (HR and purchasing documents)
# R2 → Manage API tokens → "Object Read & Write" on both buckets.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sanity-public
# R2_PRIVATE_BUCKET=sanity-private
# R2_PUBLIC_URL=https://files.your-domain.ma
# Quota per client when neither the client nor its plan sets one (MB):
# STORAGE_DEFAULT_QUOTA_MB=1024

# EMAIL (sending bons de commande / demandes de prix to suppliers)
# ------------------------------------------------------------
# Leave SMTP_HOST empty to run in placeholder mode: nothing is sent,
# every email is recorded in the EmailOutbox collection as "simulated".
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<a Gmail "app password">.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Company <achats@yourcompany.ma>"

# API rate limit per 15 minutes (optional): per signed-in user / per IP for anonymous calls
# RATE_LIMIT_USER_MAX=3000
# RATE_LIMIT_IP_MAX=600

# Assistant Sanity (in-app help + the company's own figures). With a key,
# answers come from Claude (claude-opus-5-5), grounded in
# config/assistantGuide.md. Figures (sales, a customer's purchases, stock,
# balances, forecast) are read through read-only tools checked against the
# user's permissions (services/assistantTools.js) — only the rows needed to
# answer are sent. Without a key the assistant answers from the guide alone.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_RATE_MAX=30            # questions per user per 10 minutes

# ------------------------------------------------------------
# PUBLIC LINKS (PDF sent on WhatsApp, Meta webhook)
# ------------------------------------------------------------
# The API's public address, reachable from a customer's phone (HTTPS).
PUBLIC_API_URL=https://api.your-domain.ma
# Secret for signed document links (defaults to JWT_SECRET) and their lifetime.
# PUBLIC_LINK_SECRET=
# PUBLIC_LINK_DAYS=30

# ------------------------------------------------------------
# WHATSAPP BUSINESS (Meta Cloud API) — docs/OWNER-GUIDE.md §3
# ------------------------------------------------------------
# Leave WHATSAPP_TOKEN empty: Sanity opens WhatsApp with the message ready
# (wa.me link), a person presses Send. With the API: sent directly, receipts
# followed, automatic reminders possible.
# WHATSAPP_TOKEN=                 # permanent System User token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=          # any string, also typed in Meta's webhook form
# WHATSAPP_APP_SECRET=            # checks Meta's signature on the webhook
# Approved message templates (names), French by default:
# WHATSAPP_TEMPLATE_LANG=fr
# WHATSAPP_TEMPLATE_INVOICE=      # {{1}} client {{2}} n° facture {{3}} montant {{4}} échéance + PDF header
# WHATSAPP_TEMPLATE_STATEMENT=    # {{1}} client {{2}} solde {{3}} échu + PDF header
# WHATSAPP_TEMPLATE_REMINDER=     # {{1}} client {{2}} montant échu {{3}} nb factures {{4}} échéance + PDF header

# ------------------------------------------------------------
# E-INVOICING (DGI clearance) — docs/OWNER-GUIDE.md §2
# ------------------------------------------------------------
# Mode "simulation" (Comptabilité & TVA › Paramètres) needs nothing.
# Mode "http": the platform of the DGI or of your certified provider.
# EINVOICE_API_URL=
# EINVOICE_API_KEY=
# EINVOICE_CUSTOMIZATION_ID=      # UBL CustomizationID required by the platform

# ------------------------------------------------------------
# PRODUCTION OPERATIONS (see docs/SECURITY.md, scripts/BACKUP_RESTORE.md)
# ------------------------------------------------------------
NODE_ENV=production
# Number of proxies in front of the server (Render/Railway/Heroku/nginx = 1).
# 0 if the server is reached directly. Wrong value = rate limits shared by everyone.
TRUST_PROXY=1
# Version shown in /health and attached to error reports
BUILD_ID=
# Public URL of the web app (links in alert e-mails)
PUBLIC_APP_URL=https://app.your-domain.ma

# Error monitoring alerts (first occurrence of each new error)
ALERT_EMAIL=ops@your-domain.ma
# Slack / Discord / Teams / any JSON webhook (optional)
ALERT_WEBHOOK_URL=

# Automatic backups: daily at BACKUP_HOUR, verified, kept BACKUP_KEEP_DAYS days.
# BACKUP_DIR must be a mounted volume copied off the server.
BACKUP_DIR=
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# EMPTY scratch database for the weekly restore drill (never the live one)
BACKUP_DRILL_URI=
